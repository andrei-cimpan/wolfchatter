# Local development defaults. These match docker-compose.yml and are not secrets.
DATABASE_URL=postgres://wolfchatter:wolfchatter@localhost:5432/wolfchatter
# npm test creates and migrates this database, and empties its tables between tests.
TEST_DATABASE_URL=postgres://wolfchatter:wolfchatter@localhost:5432/wolfchatter_test
# npm run e2e creates and migrates this database, empties it once per run, and points the app at it.
E2E_DATABASE_URL=postgres://wolfchatter:wolfchatter@localhost:5432/wolfchatter_e2e

# Optional per-IP POST limits per minute (defaults: 10 rooms, 30 messages). Positive integers only.
# Playwright raises both for its dev server, since every test browser shares one address.
# RATE_LIMIT_ROOMS_PER_MINUTE=10
# RATE_LIMIT_MESSAGES_PER_MINUTE=30

# Optional overrides for the db service in docker-compose.yml
# POSTGRES_USER=wolfchatter
# POSTGRES_PASSWORD=wolfchatter
# POSTGRES_DB=wolfchatter
# POSTGRES_PORT=5432

# Optional basemap override (default: OpenStreetMap). Setting the URL requires the attribution too.
# Read at build time, so restart `npm run dev` or rebuild after changing them.
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/stamen_watercolor/{z}/{x}/{y}.jpg
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; Stadia Maps &copy; Stamen Design &copy; OpenStreetMap contributors
