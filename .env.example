# Local development defaults for the local Supabase stack (npm run db:start). These are the
# Supabase CLI's fixed local values and are not secrets; `npx supabase status` prints them.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# The app reads DATABASE_URL. npm test and npm run e2e point it at SUPABASE_DB_URL themselves, and
# empty that database: dev data there does not survive a test run.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional: E2E_PORT (default 3100) moves the e2e dev server off a port another server is using.
# E2E_REUSE_SERVER=1 reuses a server already on that port instead of failing; it keeps its own env.

# Optional per-IP POST limits per minute (defaults: 10 rooms, 30 messages). Positive integers only.
# Playwright raises both for its dev server, since every test browser shares one address.
# RATE_LIMIT_ROOMS_PER_MINUTE=10
# RATE_LIMIT_MESSAGES_PER_MINUTE=30

# Optional basemap override (default: OpenStreetMap). Setting the URL requires the attribution too.
# Read at build time, so restart `npm run dev` or rebuild after changing them.
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/stamen_watercolor/{z}/{x}/{y}.jpg
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; Stadia Maps &copy; Stamen Design &copy; OpenStreetMap contributors
