# Local development defaults for the local Supabase stack (npm run db:start). These are the
# Supabase CLI's fixed local values and are not secrets; `npx supabase status` prints them.
# The app reads and writes through the API with the anon key; row-level security decides the rest.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# The database itself, for test setup only; the app does not read it.
# npm test and npm run e2e empty this database, so dev data there does not survive a test run.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Test setup only: creates signed-in test users through the admin API. The app never reads it,
# and it must never be given to the deployed app. This is the local stack's fixed value.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# Google sign-in for local Supabase (supabase/config.toml reads these). Create the OAuth client in
# Google Cloud (Web application, redirect URI http://127.0.0.1:54321/auth/v1/callback); restart the
# stack after changing them. Secrets: they go in .env only. Tests do not need them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: E2E_PORT (default 3100) moves the e2e dev server off a port another server is using.
# E2E_REUSE_SERVER=1 reuses a server already on that port instead of failing; it keeps its own env.

# Optional per-IP POST limits per minute (defaults: 10 rooms, 30 messages). Positive integers only.
# Playwright raises both for its dev server, since every test browser shares one address.
# RATE_LIMIT_ROOMS_PER_MINUTE=10
# RATE_LIMIT_MESSAGES_PER_MINUTE=30

# Optional basemap override (default: OpenStreetMap). Setting the URL requires the attribution too.
# Read at build time, so restart `npm run dev` or rebuild after changing them.
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/stamen_watercolor/{z}/{x}/{y}.jpg
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; Stadia Maps &copy; Stamen Design &copy; OpenStreetMap contributors
